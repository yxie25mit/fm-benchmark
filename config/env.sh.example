# =============================================================================
#  USAGE:  cp config/env.sh.example config/env.sh   &&   source config/env.sh
#
#  You normally DON'T edit anything — every path auto-detects.
#  ONLY if `source` prints "conda: command not found", set the one line marked
#  [EDIT] below to the folder that holds your conda envs.
# =============================================================================

# [EDIT only if conda isn't on your PATH]
# The folder that CONTAINS your conda envs (orchestrator/, chemprop2/, molclr/, ...).
# Auto-detected from `conda info --base`. To set by hand, replace the whole line with e.g.:
#     export PIPELINE_CONDA_ENVS=/home/you/miniconda3/envs
export PIPELINE_CONDA_ENVS="${PIPELINE_CONDA_ENVS:-$(conda info --base 2>/dev/null)/envs}"

# ---- everything below auto-fills; no edits needed ----
export PIPELINE_PYTHON="$PIPELINE_CONDA_ENVS/orchestrator/bin/python"     # the 'orchestrator' env
_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"                  # this repo's root
export MOLFCL_DIR="$_REPO/forks/MolFCL"                                   # fork submodules (from --recursive clone)
export MOTIL_DIR="$_REPO/forks/MotiL/MotiL_micromolecule"
export MOLFORMER_DIR="$_REPO/forks/molformer"
export CHEMELEON_HOME="$_REPO/foundations/chemeleon"                      # where download_checkpoints.sh puts CheMeleon

# ---- OPTIONAL: load YOUR OWN fine-tuned checkpoints instead of the defaults ----
# export CHEMELEON_CKPT=/path/to/your_chemeleon.pt      # a .pt file
# export MOLCLR_CKPT_DIR=/path/to/dir_with/checkpoints/model.pth
# export MOLFCL_CKPT=/path/to/your.pkl
# export MOTIL_CKPT=/path/to/your.pkl
# export MOLFORMER_CKPT=/path/to/your.ckpt
