# Source this before running the pipeline on a NEW machine:  source config/env.sh
# Edit each path to where you put the conda envs and the assets bundle (forks + checkpoints).

# Directory that CONTAINS the recreated conda envs (orchestrator/ chemprop2/ molclr/ molfcl/ molformer/):
export PIPELINE_CONDA_ENVS=/path/to/conda/envs

# The python that runs the orchestration (the lightweight 'orchestrator' env):
export PIPELINE_PYTHON="$PIPELINE_CONDA_ENVS/orchestrator/bin/python"

# Fork repos + their checkpoints (from the assets bundle):
export MOLFCL_DIR=/path/to/assets/MolFCL
export MOTIL_DIR=/path/to/assets/MotiL/MotiL_micromolecule
export MOLFORMER_DIR=/path/to/assets/molformer
export CHEMELEON_HOME=/path/to/assets/chemmeleon_home   # contains .chemprop/chemeleon_mp.pt

# (MolCLR's pretrained GIN is shipped inside the repo at methods/molclr/ckpt/ when built with rsync -L.)

# Optional — load YOUR OWN fine-tuned checkpoints instead of the defaults:
# export CHEMELEON_CKPT=/path/to/your_chemeleon.pt
# export MOLCLR_CKPT_DIR=/path/to/dir_with_checkpoints_model.pth
# export MOLFCL_CKPT=/path/to/your.pkl
# export MOTIL_CKPT=/path/to/your.pkl
# export MOLFORMER_CKPT=/path/to/your.ckpt
